  "fixed_sql": [
    {
      "name": "ops",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ops\" (\"op_id\" TEXT NOT NULL, \"hlc\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL, \"entity_kind\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"op_kind\" TEXT NOT NULL, \"field\" TEXT NULL, \"value\" TEXT NULL, \"tx_group_id\" TEXT NOT NULL, \"undo_of\" TEXT NULL, PRIMARY KEY (\"op_id\"));"
        }
      ]
    },
    {
      "name": "entities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entities\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"doc_id\" TEXT NULL, \"page_id\" TEXT NULL, \"mark_type\" TEXT NULL, \"bx0\" REAL NULL, \"by0\" REAL NULL, \"bx1\" REAL NULL, \"by1\" REAL NULL, \"fields\" TEXT NOT NULL, \"field_hlcs\" TEXT NOT NULL, \"life_hlc\" TEXT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), \"created_hlc\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pdf_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pdf_files\" (\"source_hash\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"byte_length\" INTEGER NOT NULL, \"imported_at\" INTEGER NOT NULL, PRIMARY KEY (\"source_hash\"));"
        }
      ]
    },
    {
      "name": "device",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"device\" (\"slot\" INTEGER NOT NULL DEFAULT 0, \"device_id\" TEXT NOT NULL, PRIMARY KEY (\"slot\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "view_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"view_states\" (\"doc_id\" TEXT NOT NULL, \"x\" REAL NOT NULL, \"y\" REAL NOT NULL, \"zoom\" REAL NOT NULL, PRIMARY KEY (\"doc_id\"));"
        }
      ]
    },
    {
      "name": "ops_hlc",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX ops_hlc ON ops (hlc)"
        }
      ]
    },
    {
      "name": "ops_entity",
